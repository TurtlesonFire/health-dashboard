# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---- Node / frontend ----
node_modules/
dist/
# Any build output dir, including ad-hoc verification builds
# (dist-verify, dist-verify2, ...) that must never be committed.
dist-*/
.vite/
npm-debug.log*
yarn-error.log*

# ---- Local data (derived, regenerable) ----
# The SQLite DB is built from the public WHO GHO + World Bank APIs by
# `python -m app.etl.pipeline`. It is an artifact, not source — regenerate
# rather than commit so the repo never carries stale health data.
data/*.db
data/*.db-journal
data/*.db.bak-*
data/*.sqlite*

# Static API export (frontend/public/api/) is likewise derived — see
# frontend/public/.gitignore.

# ---- Secrets / local config ----
# No secrets today (both APIs are keyless), but keep credentials out of git
# by default so a key added later can never be committed by accident.
.env
.env.*
!.env.example

# Vite env files are the exception: VITE_* values are inlined into the client
# bundle at build time, so they are public by definition and must not carry
# secrets. Committing them documents the deploy-time configuration.
!frontend/.env
!frontend/.env.*

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
