# Deployment build settings for the frontend.
#
#   api    — call the FastAPI backend through the Vite dev proxy.
#            Requires `uvicorn app.main:app` on :8000. Used for development.
#   static — read pre-rendered JSON from /api/*.json, produced by
#            scripts/export_static.py. Used for the deployed site.
#
# The default is `api` so `npm run dev` works with no setup. Deployment sets
# this to `static` (build-static.ps1 does it, and hosting platforms can set it
# as an environment variable).
VITE_DATA_MODE=api
